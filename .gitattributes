# Auto detect text files and perform LF normalization
* text=auto

# Godot/compiler sources are hashed as canonical LF text across Windows/macOS/Linux.
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
