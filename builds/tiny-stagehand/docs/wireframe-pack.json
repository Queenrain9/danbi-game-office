{
  "id": "6a8608cf-6df3-4ed1-a754-be4f659e80e3",
  "design_id": "0798b6f0-7f9b-4fb9-966c-6f5db6f002b2",
  "idea_id": "201b2137-fd0d-4acd-9daf-ea1559ba5553",
  "title": "Tiny Stagehand",
  "version": "v0.2",
  "target_device": "Mobile",
  "orientation": "portrait",
  "interaction_principles": [
    "무대 결과는 항상 상단에서 보임",
    "컨트롤은 중단, cue 선읽기는 하단 고정",
    "active prop drag가 다른 drag보다 우선",
    "incident는 별도 미니게임이 아니라 동일 화면 overlay"
  ],
  "global_ui_rules": {
    "persistent": [
      "continuity",
      "time",
      "cue strip"
    ],
    "safe_margin_percent": 4,
    "modal_blocks_background": true,
    "min_touch_target_percent": 8
  },
  "screen_flow": {
    "guards": [
      "result on timeline end or continuity 0",
      "help/pause freeze timeline"
    ],
    "normal": [
      "lobby",
      "briefing",
      "countdown",
      "live",
      "result",
      "lobby|briefing"
    ],
    "branches": [
      "live→pause→live",
      "live→cue_help→live",
      "incident is live variant"
    ]
  },
  "screens": [
