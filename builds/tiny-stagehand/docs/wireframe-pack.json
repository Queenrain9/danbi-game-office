      "edge_cases": [
        "max 2 active cues + 1 incident",
        "same wrong input twice -> control label pulse"
      ],
      "transitions": [
        {
          "to": "result",
          "from": "performance",
          "trigger": "timeline end or continuity=0",
          "animation": "stage dim",
          "condition": "always"
        },
        {
          "to": "pause",
          "from": "performance",
          "trigger": "pause_btn",
          "animation": "overlay",
          "condition": "performance"
        },
        {
          "to": "cue_help",
          "from": "performance",
          "trigger": "help",
          "animation": "overlay",
          "condition": "performance"
        }
      ],
      "interactions": [
        {
          "input": "vertical drag",
          "action": "set intensity 0..100",
          "target": "light_a/light_b",
          "feedback": "stage brightness + detent haptic",
          "precondition": "performance",
          "state_change": "light value",
          "invalid_input": "other controls do not capture active fader pointer"
        },
        {
          "input": "vertical drag",
          "action": "set curtain 0..100",
          "target": "curtain_rope",
          "feedback": "direct curtain + rope sound",
          "precondition": "performance",
          "state_change": "curtain position",
          "invalid_input": "prop drag has priority"
        },
        {
          "input": "80ms hold then drag",
          "action": "stage prop",
          "target": "prop_1/2/3 → prop_mark",
          "feedback": "ghost glow + snap haptic",
          "precondition": "mark_open",
          "state_change": "prop staged",
          "invalid_input": "invalid release -> tray return"
        },
        {
          "input": "tap/short drag",
          "action": "resolve one-step incident",
          "target": "incident hotspot",
          "feedback": "marker clear + two-note resolve",
          "precondition": "incident active",
          "state_change": "resolved",
          "invalid_input": "outside hotspot passes to normal control"
        },
        {
          "input": "tap",
          "action": "open cue help",
          "target": "help",
          "feedback": "modal",
          "precondition": "performance",
          "state_change": "paused/help",
          "invalid_input": "none"
        }
      ],
      "state_variants": [
        {
          "id": "cue_window",
          "name": "CUE WINDOW",
          "notes": "perfect ±0.35s",
          "condition": "cue within ±0.9s",
          "component_overrides": {
            "cue_now": {
              "label": "NOW · ACTIVE"
            },
            "cue_next": {
              "label": "NEXT · ghost"
            }
          }
        },
        {
          "id": "prop_drag",
          "name": "PROP DRAG",
          "notes": "prop drag > curtain > fader > cue tap",
          "condition": "prop pointer held >80ms",
          "component_overrides": {
            "prop_1": {
              "label": "PROP · dragging"
            },
            "prop_mark": {
              "label": "VALID MARK · glow"
            }
          }
        },
        {
          "id": "incident",
          "name": "INCIDENT",
          "notes": "normal performance continues; hotspot intercepts only its area",
          "condition": "incident active",
          "components": [
            {
              "id": "incident_hotspot",
              "box": {
                "h": 12,
                "w": 18,
                "x": 70,
                "y": 18
              },
              "type": "hotspot",
              "label": "INCIDENT",
              "enabled_when": null,
              "state_binding": "incident_focus",
              "interaction_role": "incident"
            }
          ]
        },
        {
          "id": "miss",
          "name": "MISS FEEDBACK",
          "notes": "affected control outline pulses",
          "condition": "cue missed",
          "components": [
            {
              "id": "miss_tag",
              "box": {
                "h": 7,
                "w": 28,
                "x": 36,
                "y": 14
              },
              "type": "feedback",
              "label": "MISS · -15",
              "state_binding": "performance"
            }
          ]
        }
      ],
      "implementation_notes": [
        "single pointer owns selected control until release",
        "incident hotspot intercept only within bounds"
      ]
    },
