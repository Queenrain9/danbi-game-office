  "global_states": [
    {
      "id": "paused",
      "rule": "freeze timeline and controls"
    },
    {
      "id": "input_lock",
      "rule": "countdown/result transition"
    }
  ],
  "input_map": [
    {
      "use": "prop",
      "input": "80ms hold+drag",
      "priority": 5
    },
    {
      "use": "curtain",
      "input": "vertical drag",
      "priority": 4
    },
    {
      "use": "light",
      "input": "vertical drag",
      "priority": 3
    },
    {
      "use": "incident",
      "input": "tap/short drag in hotspot",
      "priority": 4
    }
  ],
