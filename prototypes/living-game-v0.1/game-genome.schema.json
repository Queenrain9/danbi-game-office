{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danbi.game/schemas/game-genome-v0.1.json",
  "title": "Game Genome v0.1",
  "type": "object",
  "required": ["schema_version","game_id","title","created_at","genres","synopsis","need_vector","kernels","world_seed","actions","progress"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "game_id": {"type":"string","minLength":1},
    "template_id": {"type":"string"},
    "title": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"},
    "origin": {"enum":["self","gift"]},
    "genres": {"type":"array","items":{"type":"string"},"minItems":1},
    "synopsis": {"type":"string"},
    "need_vector": {
      "type":"object",
      "additionalProperties":{"type":"number","minimum":-1,"maximum":1}
    },
    "diagnostic_evidence": {"type":"array","items":{"type":"object"}},
    "kernels": {
      "type":"array",
      "items":{"type":"object","required":["id","weight"],"properties":{"id":{"type":"string"},"weight":{"type":"number"}}}
    },
    "world_seed": {"type":"integer","minimum":0},
    "actions": {"type":"array","items":{"type":"string"},"minItems":1},
    "progress": {
      "type":"object",
      "required":["level","xp","visits","actions"],
      "properties":{
        "level":{"type":"integer","minimum":1},
        "xp":{"type":"integer","minimum":0},
        "visits":{"type":"integer","minimum":0},
        "actions":{"type":"integer","minimum":0}
      }
    },
    "event_log":{"type":"array","items":{"type":"string"}}
  }
}