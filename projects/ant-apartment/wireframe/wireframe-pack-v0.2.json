{
  "id": "5605e8e9-66a7-4aca-b082-ed4984bde157",
  "title": "Ant Apartment",
  "source": "chat_automation",
  "status": "wireframe",
  "idea_id": "e7b2b26d-1a16-4ccd-840c-857644844bc8",
  "screens": [
    {
      "id": "mission_select",
      "name": "Mission Select",
      "order": 1,
      "layout": {
        "regions": [
          {
            "h": 14,
            "w": 100,
            "x": 0,
            "y": 0,
            "id": "header",
            "role": "title/progress",
            "label": "Mission Header"
          },
          {
            "h": 72,
            "w": 90,
            "x": 5,
            "y": 16,
            "id": "list",
            "role": "mission cards",
            "label": "Mission List"
          },
          {
            "h": 8,
            "w": 90,
            "x": 5,
            "y": 90,
            "id": "footer",
            "role": "navigation",
            "label": "Footer"
          }
        ]
      },
      "states": [
        {
          "id": "mission_select",
          "condition": "screen entered"
        }
      ],
      "purpose": "MVP에서 제공되는 mission entry를 선택하고 Brief로 이동.",
      "feedback": [
        "card press"
      ],
      "components": [
        {
          "id": "title",
          "box": {
            "h": 6,
            "w": 70,
            "x": 5,
            "y": 4
          },
          "type": "label",
          "label": "Ant Apartment",
          "state_binding": "static"
        },
        {
          "id": "mission_list",
          "box": {
            "h": 72,
            "w": 90,
            "x": 5,
            "y": 16
          },
          "type": "list",
          "label": "Mission Cards",
          "state_binding": "missions",
          "interaction_role": "tap available mission"
        },
        {
          "id": "stars",
          "box": {
            "h": 6,
            "w": 19,
            "x": 76,
            "y": 4
          },
          "type": "counter",
          "label": "Stars",
          "state_binding": "progress.stars"
        }
      ],
      "edge_cases": [
        "MVP content may expose only configured missions; UI must not invent extra rooms"
      ],
      "transitions": [
        {
          "to": "mission_brief",
          "from": "mission_select",
          "trigger": "tap mission",
          "animation": "push",
          "condition": "available"
        }
      ],
      "interactions": [
        {
          "input": "tap",
          "action": "select mission",
          "target": "available mission card",
          "feedback": "pressed state",
          "precondition": "mission available",
          "state_change": "selected_mission=id",
          "invalid_input": "unavailable card: inert"
        }
      ],
      "state_variants": [],
      "implementation_notes": [
        "List is data-driven."
      ]
    },
    {
      "id": "mission_brief",
      "name": "Mission Brief",
      "order": 2,
      "layout": {
        "regions": [
          {
            "h": 24,
            "w": 90,
            "x": 5,
            "y": 8,
            "id": "goal",
            "role": "objective",
            "label": "Goal"
          },
          {
            "h": 24,
            "w": 90,
            "x": 5,
            "y": 34,
            "id": "risk",
            "role": "hazard brief",
            "label": "Hazard"
          },
          {
            "h": 22,
            "w": 90,
            "x": 5,
            "y": 60,
            "id": "preview",
            "role": "preview",
            "label": "Room Preview"
          },
          {
            "h": 11,
            "w": 90,
            "x": 5,
            "y": 85,
            "id": "actions",
            "role": "start",
            "label": "Actions"
          }
        ]
      },
      "states": [
        {
          "id": "brief",
          "condition": "mission selected"
        }
      ],
      "purpose": "목표와 위험 정보를 읽고 Scout 시작.",
      "feedback": [
        "start cue"
      ],
      "components": [
        {
          "id": "goal",
          "box": {
            "h": 24,
            "w": 90,
            "x": 5,
            "y": 8
          },
          "type": "goal_card",
          "label": "Deliver 8 food",
          "state_binding": "mission.goal"
        },
        {
          "id": "hazard",
          "box": {
            "h": 24,
            "w": 90,
            "x": 5,
            "y": 34
          },
          "type": "risk_card",
          "label": "Hazard Brief",
          "state_binding": "mission.hazard"
        },
        {
          "id": "preview",
          "box": {
            "h": 22,
            "w": 90,
            "x": 5,
            "y": 60
          },
          "type": "diagram",
          "label": "Room Preview",
          "state_binding": "mission.preview"
        },
        {
          "id": "start",
          "box": {
            "h": 9,
            "w": 40,
            "x": 55,
            "y": 86
          },
          "type": "button",
          "label": "Start Scout",
          "enabled_when": "mission loaded",
          "state_binding": "brief.ready",
          "interaction_role": "tap"
        },
        {
          "id": "back",
          "box": {
            "h": 9,
            "w": 30,
            "x": 5,
            "y": 86
          },
          "type": "button",
          "label": "Back",
          "state_binding": "nav",
          "interaction_role": "tap"
        }
      ],
      "edge_cases": [],
      "transitions": [
        {
          "to": "apartment_room",
          "from": "mission_brief",
          "trigger": "Start",
          "animation": "push",
          "condition": "loaded"
        },
        {
          "to": "mission_select",
          "from": "mission_brief",
          "trigger": "Back",
          "animation": "pop",
          "condition": "always"
        }
      ],
      "interactions": [
        {
          "input": "tap",
          "action": "enter apartment room",
          "target": "Start Scout",
          "feedback": "short cue",
          "precondition": "mission loaded",
          "state_change": "phase=Scout",
          "invalid_input": "disabled while loading"
        }
      ],
      "state_variants": [],
      "implementation_notes": [
        "Hazard semantics are displayed from Game Design mission data, not invented here."
      ]
    },
    {
      "id": "apartment_room",
      "core": true,
      "name": "Apartment Room",
      "order": 3,
      "layout": {
        "regions": [
          {
            "h": 12,
            "w": 100,
            "x": 0,
            "y": 0,
            "id": "hud",
            "role": "persistent HUD",
            "label": "Goal / Time / Status"
          },
          {
            "h": 76,
            "w": 100,
            "x": 0,
            "y": 12,
            "id": "world",
            "role": "top-down playfield",
            "label": "Room World"
          },
          {
            "h": 12,
            "w": 100,
            "x": 0,
            "y": 88,
            "id": "controls",
            "role": "dispatch/pause",
            "label": "Primary Controls"
          }
        ]
      },
      "states": [
        {
          "id": "scout",
          "condition": "phase=Scout"
        },
        {
          "id": "route_edit",
          "condition": "food found and route gesture begins"
        },
        {
          "id": "haul",
          "condition": "valid route dispatched"
        },
        {
          "id": "haul_warning",
          "condition": "hazard warning active"
        },
        {
          "id": "route_blocked",
          "condition": "active route blocked"
        }
      ],
      "purpose": "Scout→RouteEdit→Haul의 핵심 플레이를 한 world screen에서 수행.",
      "feedback": [
        "fog reveal",
        "pheromone trail",
        "snap haptic",
        "danger pulse",
        "delivery absorb",
        "local loss cue"
      ],
      "components": [
        {
          "id": "goal_counter",
          "box": {
            "h": 7,
            "w": 25,
            "x": 3,
            "y": 2
          },
          "type": "counter",
          "label": "Food 0/8",
          "state_binding": "round.delivered"
        },
        {
          "id": "time",
          "box": {
            "h": 7,
            "w": 22,
            "x": 39,
            "y": 2
          },
          "type": "timer",
          "label": "150s",
          "state_binding": "round.time"
        },
        {
          "id": "survivors",
          "box": {
            "h": 7,
            "w": 27,
            "x": 70,
            "y": 2
          },
          "type": "counter",
          "label": "Workers 12",
          "state_binding": "round.survivors"
        },
        {
          "id": "world",
          "box": {
            "h": 76,
            "w": 100,
            "x": 0,
            "y": 12
          },
          "type": "world_view",
          "label": "Apartment World / Fog",
          "state_binding": "world.reveal",
          "interaction_role": "tap destination / pan"
        },
        {
          "id": "scout",
          "box": {
            "h": 58,
            "w": 84,
            "x": 8,
            "y": 18
          },
          "type": "world_entity",
          "label": "Scout Ant",
          "enabled_when": "phase in Scout,Haul",
          "state_binding": "scout.position",
          "interaction_role": "tap destination"
        },
        {
          "id": "nest",
          "box": {
            "h": 16,
            "w": 20,
            "x": 6,
            "y": 68
          },
          "type": "world_entity",
          "label": "Nest Endpoint",
          "state_binding": "world.nest"
        },
        {
          "id": "food",
          "box": {
            "h": 18,
            "w": 22,
            "x": 72,
            "y": 20
          },
          "type": "world_entity",
          "label": "Food Endpoint",
          "state_binding": "world.food"
        },
        {
          "id": "route_layer",
          "box": {
            "h": 66,
            "w": 92,
            "x": 4,
            "y": 16
          },
          "type": "editable_path",
          "label": "Pheromone Route",
          "enabled_when": "phase in RouteEdit or Haul paused/editable",
          "state_binding": "route.state",
          "interaction_role": "draw/edit/delete"
        },
        {
          "id": "waypoints",
          "box": {
            "h": 66,
            "w": 92,
            "x": 4,
            "y": 16
          },
          "type": "hit_targets",
          "label": "Route Waypoints",
          "enabled_when": "route exists && route editing",
          "state_binding": "route.waypoints",
          "interaction_role": "drag waypoint"
        },
        {
          "id": "hazard_layer",
          "box": {
            "h": 66,
            "w": 92,
            "x": 4,
            "y": 16
          },
          "type": "world_overlay",
          "label": "Hazard / Warning",
          "state_binding": "hazard.state"
        },
        {
          "id": "convoy",
          "box": {
            "h": 66,
            "w": 92,
            "x": 4,
            "y": 16
          },
          "type": "world_entities",
          "label": "Worker Convoy",
          "state_binding": "convoy.state"
        },
        {
          "id": "route_budget",
          "box": {
            "h": 6,
            "w": 35,
            "x": 3,
            "y": 80
          },
          "type": "meter",
          "label": "Pheromone 100",
          "state_binding": "route.budget"
        },
        {
          "id": "eta_risk",
          "box": {
            "h": 6,
            "w": 32,
            "x": 41,
            "y": 80
          },
          "type": "status",
          "label": "ETA / Risk",
          "state_binding": "route.metrics"
        },
        {
          "id": "dispatch",
          "box": {
            "h": 8,
            "w": 22,
            "x": 75,
            "y": 89
          },
          "type": "button",
          "label": "Dispatch",
          "enabled_when": "phase=RouteEdit && route valid && !blocked && !over_budget",
          "state_binding": "route.valid",
          "interaction_role": "tap"
        },
        {
          "id": "pause",
          "box": {
            "h": 8,
            "w": 22,
            "x": 3,
            "y": 89
          },
          "type": "button",
          "label": "Pause",
          "enabled_when": "phase=Haul",
          "state_binding": "convoy.paused",
          "interaction_role": "tap"
        },
        {
          "id": "warning_banner",
          "box": {
            "h": 8,
            "w": 50,
            "x": 25,
            "y": 13
          },
          "type": "banner",
          "label": "Hazard Warning",
          "state_binding": "hazard.warning"
        }
      ],
      "edge_cases": [
        "input priority UI > waypoint > path > world",
        "no automatic reroute on blocked route",
        "dispatch remains disabled for invalid route",
        "camera pan must not steal waypoint/path drag"
      ],
      "transitions": [
        {
          "to": "pause_route_overlay",
          "from": "apartment_room",
          "trigger": "tap Pause",
          "animation": "overlay",
          "condition": "phase=Haul"
        },
        {
          "to": "result",
          "from": "apartment_room",
          "trigger": "target food delivered",
          "animation": "push",
          "condition": "success"
        },
        {
          "to": "result",
          "from": "apartment_room",
          "trigger": "time expires or no transport-capable ants",
          "animation": "push",
          "condition": "failure"
        }
      ],
      "interactions": [
        {
          "input": "tap",
          "action": "set scout destination",
          "target": "walkable floor destination",
          "feedback": "reveal ring + discovery ping",
          "precondition": "scout available",
          "state_change": "scout moves; nearby map reveals",
          "invalid_input": "invalid/unwalkable destination does not move scout"
        },
        {
          "input": "drag",
          "action": "sample waypoints every 12px and preview path",
          "target": "route layer from nest or food",
          "feedback": "pheromone trail + live budget",
          "precondition": "food found / RouteEdit",
          "state_change": "route geometry/budget update",
          "invalid_input": "blocked segment becomes broken preview; dispatch disabled"
        },
        {
          "input": "tap path then drag",
          "action": "move waypoint",
          "target": "waypoint",
          "feedback": "direction arrows + snap haptic",
          "precondition": "route exists and editing allowed",
          "state_change": "followers switch at next node when applicable",
          "invalid_input": "invalid placement remains broken preview"
        },
        {
          "input": "long press",
          "action": "delete segment",
          "target": "route segment",
          "feedback": "segment fade",
          "precondition": "route exists and editing allowed",
          "state_change": "route becomes incomplete",
          "invalid_input": "dispatch disabled until reconnected"
        },
        {
          "input": "tap",
          "action": "start workers hauling",
          "target": "Dispatch",
          "feedback": "nest pulse + short cue",
          "precondition": "route valid",
          "state_change": "phase=Haul",
          "invalid_input": "disabled for incomplete/blocked/over-budget route"
        },
        {
          "input": "tap",
          "action": "enter pause/route edit overlay",
          "target": "Pause",
          "feedback": "warning pulse",
          "precondition": "phase=Haul",
          "state_change": "convoy.paused=true",
          "invalid_input": "disabled outside Haul"
        },
        {
          "input": "two-finger pan",
          "action": "pan camera",
          "target": "world",
          "feedback": "direct manipulation",
          "precondition": "always in room",
          "state_change": "camera offset changes",
          "invalid_input": "gesture wins over one-finger route edit"
        },
        {
          "input": "one-finger pan",
          "action": "pan camera",
          "target": "world background",
          "feedback": "direct manipulation",
          "precondition": "outside route edit",
          "state_change": "camera offset changes",
          "invalid_input": "ignored during route editing to protect path gesture"
        },
        {
          "input": "two-finger tap",
          "action": "cancel gesture",
          "target": "active route gesture",
          "feedback": "preview retracts",
          "precondition": "gesture active",
          "state_change": "restore pre-gesture route",
          "invalid_input": "none"
        }
      ],
      "state_variants": [
        {
          "id": "scout_reveal",
          "name": "Scout Reveal",
          "notes": "Tap walkable revealed floor to scout; discovery reveals nearby map.",
          "condition": "phase=Scout",
          "components": [],
          "hide_components": [
            "route_layer",
            "waypoints",
            "dispatch",
            "pause",
            "convoy"
          ],
          "component_overrides": {
            "scout": {
              "state_binding": "scout.position"
            },
            "world": {
              "state_binding": "fog + reveal ring"
            }
          }
        },
        {
          "id": "route_incomplete",
          "name": "Route Incomplete",
          "notes": "Live path and budget visible.",
          "condition": "phase=RouteEdit && route incomplete",
          "components": [],
          "hide_components": [
            "pause",
            "convoy"
          ],
          "component_overrides": {
            "dispatch": {
              "state_binding": "disabled"
            },
            "route_layer": {
              "state_binding": "route.incomplete"
            }
          }
        },
        {
          "id": "route_valid",
          "name": "Route Valid",
          "notes": "Endpoint snap feedback.",
          "condition": "route connected && within budget && unblocked",
          "components": [],
          "hide_components": [
            "pause",
            "convoy"
          ],
          "component_overrides": {
            "dispatch": {
              "state_binding": "enabled"
            },
            "route_layer": {
              "state_binding": "route.valid"
            }
          }
        },
        {
          "id": "route_invalid",
          "name": "Blocked / Over Budget",
          "notes": "Invalid segment is broken preview.",
          "condition": "route blocked or over budget",
          "components": [],
          "hide_components": [
            "pause",
            "convoy"
          ],
          "component_overrides": {
            "dispatch": {
              "state_binding": "disabled"
            },
            "route_layer": {
              "state_binding": "broken preview"
            }
          }
        },
        {
          "id": "haul_active",
          "name": "Haul Active",
          "notes": "Workers spawn at Game Design interval and follow active path.",
          "condition": "phase=Haul && !paused",
          "components": [],
          "hide_components": [
            "dispatch",
            "waypoints"
          ],
          "component_overrides": {
            "pause": {
              "label": "Pause"
            },
            "convoy": {
              "state_binding": "convoy moving"
            }
          }
        },
        {
          "id": "haul_warning",
          "name": "Hazard Warning",
          "notes": "Direction pulse + medium haptic; no automatic reroute.",
          "condition": "hazard warning active",
          "components": [],
          "hide_components": [
            "dispatch"
          ],
          "component_overrides": {
            "hazard_layer": {
              "state_binding": "hazard.warning"
            },
            "warning_banner": {
              "state_binding": "2-second warning"
            }
          }
        }
      ],
      "implementation_notes": [
        "World entity boxes are touch/display envelopes; actual positions come from room coordinates.",
        "Hazard visual binds to source mission hazard state; wireframe does not define a new hazard type."
      ]
    },
    {
      "id": "pause_route_overlay",
      "name": "Pause / Route Edit Overlay",
      "order": 4,
      "layout": {
        "regions": [
          {
            "h": 100,
            "w": 100,
            "x": 0,
            "y": 0,
            "id": "scrim",
            "role": "paused context",
            "label": "World Scrim"
          },
          {
            "h": 28,
            "w": 100,
            "x": 0,
            "y": 72,
            "id": "edit",
            "role": "edit/restart",
            "label": "Route Edit Controls"
          }
        ]
      },
      "states": [
        {
          "id": "paused_edit",
          "condition": "Pause entered"
        },
        {
          "id": "paused_invalid",
          "condition": "edited route invalid"
        }
      ],
      "purpose": "Haul 중 convoy pause 상태에서 경로를 수정하고 재개.",
      "feedback": [
        "route arrows",
        "budget update",
        "warning pulse"
      ],
      "components": [
        {
          "id": "paused_world",
          "box": {
            "h": 72,
            "w": 100,
            "x": 0,
            "y": 0
          },
          "type": "context",
          "label": "Paused Room",
          "state_binding": "convoy.paused"
        },
        {
          "id": "route_edit_proxy",
          "box": {
            "h": 58,
            "w": 92,
            "x": 4,
            "y": 12
          },
          "type": "editable_path",
          "label": "Editable Route",
          "state_binding": "route.state",
          "interaction_role": "drag waypoint / long press segment"
        },
        {
          "id": "budget",
          "box": {
            "h": 7,
            "w": 40,
            "x": 4,
            "y": 75
          },
          "type": "meter",
          "label": "Route Budget",
          "state_binding": "route.budget"
        },
        {
          "id": "resume",
          "box": {
            "h": 9,
            "w": 37,
            "x": 58,
            "y": 86
          },
          "type": "button",
          "label": "Resume",
          "enabled_when": "route valid",
          "state_binding": "route.valid",
          "interaction_role": "tap"
        },
        {
          "id": "cancel",
          "box": {
            "h": 9,
            "w": 42,
            "x": 5,
            "y": 86
          },
          "type": "button",
          "label": "Cancel Changes",
          "state_binding": "overlay",
          "interaction_role": "tap"
        }
      ],
      "edge_cases": [
        "route must be valid before resume"
      ],
      "transitions": [
        {
          "to": "apartment_room",
          "from": "pause_route_overlay",
          "trigger": "Resume",
          "animation": "fade",
          "condition": "route valid"
        },
        {
          "to": "apartment_room",
          "from": "pause_route_overlay",
          "trigger": "Cancel Changes",
          "animation": "fade",
          "condition": "always"
        }
      ],
      "interactions": [
        {
          "input": "drag/long press",
          "action": "apply same route edit semantics",
          "target": "route edit proxy",
          "feedback": "same route feedback",
          "precondition": "paused",
          "state_change": "route changes",
          "invalid_input": "invalid route disables Resume"
        },
        {
          "input": "tap",
          "action": "close overlay and resume haul",
          "target": "Resume",
          "feedback": "short cue",
          "precondition": "route valid",
          "state_change": "convoy.paused=false",
          "invalid_input": "disabled if invalid"
        },
        {
          "input": "tap",
          "action": "restore overlay-entry route and resume/return",
          "target": "Cancel Changes",
          "feedback": "preview retracts",
          "precondition": "always",
          "state_change": "route restored",
          "invalid_input": "none"
        }
      ],
      "state_variants": [
        {
          "id": "invalid_edit",
          "name": "Invalid Edit",
          "notes": "Cannot resume onto invalid route.",
          "condition": "route invalid",
          "components": [],
          "hide_components": [],
          "component_overrides": {
            "resume": {
              "state_binding": "disabled"
            },
            "route_edit_proxy": {
              "state_binding": "broken preview"
            }
          }
        }
      ],
      "implementation_notes": [
        "Preserve Game Design pause semantics; overlay only exposes route editing."
      ]
