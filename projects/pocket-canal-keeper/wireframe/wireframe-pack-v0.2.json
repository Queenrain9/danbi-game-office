      ],
      "transitions": [
        {
          "to": "canal_board",
          "from": "stage_result",
          "trigger": "retry",
          "animation": "fade",
          "condition": "true"
        },
        {
          "to": "stage_brief",
          "from": "stage_result",
          "trigger": "next",
          "animation": "push",
          "condition": "success && next exists"
        },
        {
          "to": "stage_select",
          "from": "stage_result",
          "trigger": "next/continue",
          "animation": "pop",
          "condition": "final stage or choose select"
        }
      ],
      "interactions": [
        {
          "input": "tap",
          "action": "reset same stage",
          "target": "retry",
          "feedback": "press",
          "precondition": "result",
          "state_change": "running",
          "invalid_input": "none"
        },
        {
          "input": "tap",
          "action": "unlock/select next",
          "target": "next",
          "feedback": "press",
          "precondition": "success && next exists",
          "state_change": "brief",
          "invalid_input": "disabled pulse"
        }
      ],
      "state_variants": [
        {
          "id": "failure_result",
          "name": "Failure",
          "notes": "retry primary",
          "condition": "!success",
          "components": [],
          "hide_components": [],
          "component_overrides": {
            "next": {
              "state_binding": "disabled"
            },
            "result_title": {
              "label": "Stage Failed"
            }
          }
        }
      ],
      "implementation_notes": [
        "stars: success, no strike, under par"
      ]
    }
  ],
  "version": "v0.2",
  "design_id": "69cfd48e-f740-49c9-9f33-9171b44501b2",
  "input_map": {
    "tap": [
      "signal",
      "boat",
      "buttons"
    ],
    "cancel": "pointer cancel restores last committed device state and no operation increment",
    "arc_drag": "gate notch snap",
    "priority": [
      "active device gesture",
      "pause/popover",
      "device handles",
      "boat tap",
      "board"
    ],
