          "label": "Boat",
          "state_binding": "selected_boat"
        },
        {
          "id": "traits",
          "box": {
            "h": 10,
            "w": 34,
            "x": 16,
            "y": 67
          },
          "type": "chips",
          "label": "Traits",
          "state_binding": "size/draft/height/priority"
        },
        {
          "id": "destination",
          "box": {
            "h": 8,
            "w": 28,
            "x": 54,
            "y": 59
          },
          "type": "status",
          "label": "Destination",
          "state_binding": "destination"
        },
        {
          "id": "close",
          "box": {
            "h": 8,
            "w": 14,
            "x": 70,
            "y": 72
          },
          "type": "button",
          "label": "Close",
          "state_binding": "selected"
        }
