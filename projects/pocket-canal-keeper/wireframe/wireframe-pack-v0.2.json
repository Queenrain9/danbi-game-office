      ],
      "state_variants": [
        {
          "id": "locked_stage",
          "name": "Locked Stage",
          "notes": "locked tap pulses",
          "condition": "stage > unlocked",
          "components": [],
          "hide_components": [],
          "component_overrides": {}
        }
      ],
      "implementation_notes": [
        "six data stages"
      ]
    },
    {
