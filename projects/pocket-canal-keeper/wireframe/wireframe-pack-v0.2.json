          "label": "Success/Failure",
          "state_binding": "success"
        },
        {
          "id": "stars",
          "box": {
            "h": 9,
            "w": 50,
            "x": 25,
            "y": 30
          },
          "type": "rating",
          "label": "Stars",
          "state_binding": "score"
        },
        {
          "id": "stats",
          "box": {
            "h": 16,
            "w": 64,
            "x": 18,
            "y": 43
          },
          "type": "summary",
          "label": "Strikes / Ops",
          "state_binding": "strikes,operations,par"
        },
        {
          "id": "retry",
          "box": {
            "h": 11,
            "w": 36,
            "x": 10,
            "y": 75
          },
          "type": "button",
          "label": "Retry",
          "state_binding": "result"
