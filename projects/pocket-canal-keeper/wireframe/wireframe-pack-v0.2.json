      ],
      "transitions": [
        {
          "to": "canal_board",
          "from": "boat_inspect_popover",
          "trigger": "close/outside",
          "animation": "dismiss",
          "condition": "true"
        }
      ],
      "interactions": [
        {
          "input": "tap",
          "action": "clear selection",
          "target": "close",
          "feedback": "popover closes",
          "precondition": "open",
          "state_change": "running",
          "invalid_input": "none"
        },
        {
          "input": "tap",
          "action": "clear selection",
          "target": "outside popover",
          "feedback": "close",
          "precondition": "open",
          "state_change": "running",
          "invalid_input": "none"
        }
      ],
      "state_variants": [],
      "implementation_notes": [
        "simulation continues"
      ]
    },
    {
      "id": "pause_overlay",
      "name": "Pause Overlay",
      "order": 5,
      "layout": {
        "regions": [
          {
            "h": 50,
            "w": 70,
            "x": 15,
            "y": 25,
            "id": "modal",
            "role": "overlay",
            "label": "pause modal"
          }
        ]
      },
      "states": [
        "paused"
      ],
      "purpose": "freeze simulation and resume/restart/exit",
      "feedback": [
        "all boat/device timers frozen"
      ],
      "components": [
        {
          "id": "resume",
          "box": {
            "h": 9,
            "w": 50,
            "x": 25,
            "y": 37
          },
          "type": "button",
          "label": "Resume",
          "state_binding": "paused"
        },
        {
          "id": "restart",
          "box": {
            "h": 9,
            "w": 50,
            "x": 25,
            "y": 50
          },
          "type": "button",
          "label": "Restart",
          "state_binding": "paused"
        },
        {
          "id": "exit",
          "box": {
            "h": 9,
            "w": 50,
            "x": 25,
            "y": 63
          },
          "type": "button",
          "label": "Exit",
          "state_binding": "paused"
        }
      ],
      "edge_cases": [
        "active gesture cancelled before pause commit"
      ],
      "transitions": [
        {
          "to": "canal_board",
          "from": "pause_overlay",
          "trigger": "resume/restart",
          "animation": "fade",
          "condition": "true"
        },
        {
          "to": "stage_select",
          "from": "pause_overlay",
          "trigger": "exit",
          "animation": "pop",
          "condition": "true"
        }
      ],
      "interactions": [
        {
          "input": "tap",
          "action": "resume frozen simulation",
          "target": "resume",
          "feedback": "close",
          "precondition": "paused",
          "state_change": "previous board state",
          "invalid_input": "none"
        },
        {
          "input": "tap",
          "action": "reset stage",
          "target": "restart",
          "feedback": "reset",
          "precondition": "paused",
          "state_change": "running",
          "invalid_input": "none"
        },
        {
          "input": "tap",
          "action": "discard stage",
          "target": "exit",
          "feedback": "close",
          "precondition": "paused",
          "state_change": "select",
          "invalid_input": "none"
        }
      ],
      "state_variants": [],
      "implementation_notes": [
        "overlay only"
      ]
    },
    {
      "id": "stage_result",
      "name": "Stage Result",
      "order": 6,
      "layout": {
        "regions": [
          {
            "h": 52,
            "w": 84,
            "x": 8,
            "y": 14,
            "id": "summary",
