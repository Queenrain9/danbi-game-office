  "screens": [
    {
      "id": "stage_select",
      "name": "Stage Select",
      "order": 1,
      "layout": {
        "regions": [
          {
            "h": 10,
            "w": 88,
            "x": 6,
            "y": 5,
            "id": "header",
            "role": "status",
            "label": "progress"
          },
          {
            "h": 72,
            "w": 88,
            "x": 6,
            "y": 18,
            "id": "grid",
            "role": "selection",
            "label": "stages"
          }
        ]
      },
      "states": [
        "ready",
        "locked"
      ],
      "purpose": "select unlocked stage and view stars",
      "feedback": [
        "stars visible per completed stage"
      ],
      "components": [
        {
          "id": "stage_cards",
          "box": {
            "h": 66,
            "w": 84,
            "x": 8,
            "y": 20
          },
          "type": "grid",
          "label": "Stage cards",
          "state_binding": "unlocks/stars",
          "interaction_role": "tap stage"
        },
        {
          "id": "progress",
          "box": {
            "h": 7,
            "w": 84,
            "x": 8,
            "y": 6
          },
          "type": "status",
          "label": "Progress",
          "state_binding": "unlocked_stage"
        }
      ],
      "edge_cases": [
        "stage1 always unlocked"
      ],
      "transitions": [
        {
          "to": "stage_brief",
          "from": "stage_select",
          "trigger": "unlocked stage tap",
          "animation": "push",
          "condition": "unlocked"
