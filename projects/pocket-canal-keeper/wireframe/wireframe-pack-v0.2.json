          "invalid_input": "disabled until loaded"
        },
        {
          "input": "tap",
          "action": "return select",
          "target": "back",
          "feedback": "press",
          "precondition": "true",
          "state_change": "none",
          "invalid_input": "none"
        }
      ],
      "state_variants": [],
      "implementation_notes": [
        "read-only preview"
      ]
    },
    {
      "id": "canal_board",
      "name": "Canal Board",
      "order": 3,
      "layout": {
        "regions": [
          {
            "h": 10,
            "w": 92,
            "x": 4,
            "y": 4,
            "id": "hud",
            "role": "status",
            "label": "stage status"
          },
          {
            "h": 66,
            "w": 92,
            "x": 4,
            "y": 16,
            "id": "board",
            "role": "simulation",
            "label": "canal graph"
          },
          {
            "h": 12,
            "w": 92,
            "x": 4,
            "y": 84,
            "id": "device_tray",
            "role": "status",
            "label": "selected device/status"
          }
        ]
      },
      "states": [
        "running",
        "device_busy",
        "warning",
        "paused",
        "success_pending",
        "failure_pending"
      ],
      "purpose": "core traffic control",
      "feedback": [
        "protected occupancy visible",
        "waiting intent arrows visible",
        "device state must be readable without opening menus"
      ],
      "components": [
        {
          "id": "safety_meter",
          "box": {
            "h": 7,
            "w": 22,
            "x": 6,
            "y": 5
          },
          "type": "meter",
          "label": "Safety strikes",
          "state_binding": "strikes/3"
        },
        {
          "id": "ops_counter",
          "box": {
            "h": 7,
            "w": 20,
            "x": 31,
            "y": 5
          },
          "type": "counter",
          "label": "Operations",
          "state_binding": "operations/par"
        },
        {
          "id": "pause",
          "box": {
            "h": 7,
            "w": 10,
            "x": 84,
            "y": 5
          },
          "type": "button",
          "label": "Pause",
          "state_binding": "running/busy"
        },
        {
          "id": "canal_graph",
          "box": {
            "h": 62,
            "w": 88,
            "x": 6,
            "y": 18
          },
          "type": "world_view",
          "label": "Canal graph",
          "state_binding": "segments/occupancy/routes",
          "interaction_role": "result feedback"
        },
        {
          "id": "gate_lever",
          "box": {
            "h": 20,
            "w": 18,
            "x": 10,
            "y": 54
          },
          "type": "arc_control",
          "label": "Sluice lever",
          "enabled_when": "gate idle && interlock safe",
          "state_binding": "gate_state",
          "interaction_role": "arc drag"
        },
        {
          "id": "bridge_wheel",
          "box": {
            "h": 19,
            "w": 19,
            "x": 70,
            "y": 26
          },
          "type": "rotary",
          "label": "Bridge wheel",
          "enabled_when": "crossing empty",
          "state_binding": "bridge_state",
          "interaction_role": "circular drag"
        },
        {
          "id": "lock_control",
          "box": {
            "h": 21,
            "w": 16,
            "x": 72,
            "y": 56
          },
          "type": "vertical_slider",
          "label": "Lock level control",
          "enabled_when": "safe door sequence",
          "state_binding": "lock_level",
          "interaction_role": "vertical drag"
        },
        {
          "id": "signal_buoy",
          "box": {
            "h": 14,
            "w": 14,
            "x": 35,
            "y": 30
          },
          "type": "toggle",
          "label": "Traffic signal",
          "enabled_when": "signal available",
          "state_binding": "signal hold/go",
          "interaction_role": "tap"
        },
        {
          "id": "boat_layer",
          "box": {
            "h": 56,
            "w": 84,
            "x": 8,
            "y": 20
          },
          "type": "interactive_layer",
          "label": "Boats",
          "state_binding": "boat positions/traits",
          "interaction_role": "tap inspect"
        },
        {
          "id": "device_status",
          "box": {
            "h": 7,
            "w": 86,
            "x": 7,
            "y": 86
          },
          "type": "status",
          "label": "Device status",
          "state_binding": "selected/busy/warning"
        }
      ],
      "edge_cases": [
        "unsafe same-segment entry produces strike before visual overlap",
        "45s boat timeout fails stage",
        "device pointer owns gesture until release",
        "second touch ignored"
      ],
      "transitions": [
        {
          "to": "boat_inspect_popover",
          "from": "canal_board",
          "trigger": "boat tap",
          "animation": "popover",
          "condition": "boat exists"
        },
        {
          "to": "pause_overlay",
          "from": "canal_board",
          "trigger": "pause",
          "animation": "overlay",
          "condition": "running or device_busy"
        },
        {
          "to": "stage_result",
          "from": "canal_board",
          "trigger": "all delivered or fail",
          "animation": "result sheet",
          "condition": "terminal"
        }
      ],
      "interactions": [
        {
          "input": "arc_drag",
          "action": "snap closed/half/open",
          "target": "gate_lever",
          "feedback": "gate/water arrows + clunk/tick",
          "precondition": "idle && safe",
          "state_change": "gate state; operations+1",
          "invalid_input": "shake/no commit"
        },
        {
          "input": "circular_drag",
          "action": "toggle road/water orientation",
          "target": "bridge_wheel",
          "feedback": "gear rotation/path update",
          "precondition": "crossing empty",
          "state_change": "bridge busy then new state; operations+1",
          "invalid_input": "red crossing outline/no commit"
        },
        {
          "input": "vertical_drag",
          "action": "equalize to nearest legal low/high",
          "target": "lock_control",
          "feedback": "water/gauge/boat height",
          "precondition": "safe door sequence",
          "state_change": "device_busy then level; operations+1",
          "invalid_input": "warning/no commit"
        },
        {
          "input": "tap",
          "action": "toggle hold/go",
          "target": "signal_buoy",
          "feedback": "buoy/intent arrow",
          "precondition": "available",
          "state_change": "queue permission; operations+1",
          "invalid_input": "locked pulse"
        },
        {
          "input": "tap",
          "action": "select boat",
          "target": "boat_layer",
          "feedback": "route highlight/popover",
          "precondition": "running or device_busy",
          "state_change": "inspect selection only",
          "invalid_input": "none"
        }
      ],
      "state_variants": [
        {
          "id": "busy_variant",
          "name": "Device Busy",
          "notes": "busy device locked; independent devices remain live",
          "condition": "device animation/equalizing",
          "components": [
            {
              "id": "busy_progress",
              "box": {
                "h": 5,
                "w": 32,
                "x": 60,
                "y": 86
              },
              "type": "progress",
              "label": "Device progress",
              "state_binding": "device progress"
            }
          ],
          "hide_components": [],
          "component_overrides": {}
        },
        {
          "id": "warning_variant",
          "name": "Unsafe Command Warning",
          "notes": "red/amber only on affected zone; no invalid commit",
          "condition": "invalid interlock or protected-entry command",
          "components": [
            {
              "id": "protected_warning",
              "box": {
                "h": 35,
                "w": 60,
                "x": 20,
                "y": 30
              },
              "type": "overlay",
              "label": "Protected zone warning",
              "state_binding": "affected segment"
            }
          ],
          "hide_components": [],
          "component_overrides": {
            "device_status": {
              "label": "Unsafe command rejected"
            }
          }
        },
        {
          "id": "route_inspect",
          "name": "Boat Selected",
          "notes": "popover is separate overlay surface",
          "condition": "boat selected",
          "components": [
            {
              "id": "route_highlight",
              "box": {
                "h": 56,
                "w": 84,
                "x": 8,
                "y": 20
              },
              "type": "overlay",
              "label": "Planned route",
              "state_binding": "selected boat route"
            }
          ],
          "hide_components": [],
          "component_overrides": {}
        }
      ],
      "implementation_notes": [
        "deterministic graph simulation",
        "do not make free boat steering",
        "device handles may visually exceed physical scale"
      ]
    },
