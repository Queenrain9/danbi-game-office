        {
          "input": "two-finger twist",
          "action": "actual angle delta around pivot; collision-test",
          "target": "held furniture",
          "feedback": "footprint",
          "precondition": "held",
          "state_change": "held",
          "invalid_input": "keep last valid angle"
        },
        {
          "input": "release",
          "action": "85% overlap + <=12deg snap else rollback pre-grab",
          "target": "held furniture",
          "feedback": "snap/spring",
          "precondition": "held",
          "state_change": "idle/placed/complete",
          "invalid_input": "rollback"
        },
