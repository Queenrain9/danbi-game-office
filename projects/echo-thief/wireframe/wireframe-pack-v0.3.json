      "interactions": [
        {
          "id": "observe_guard",
          "input": "tap/hold",
          "target": "guard",
          "feedback": "patrol route preview",
          "source_refs": [
            "core_player_verbs[0]",
            "interaction_spec.planning"
          ],
          "precondition": "Planning or Infiltration and not Caught",
          "state_change": "no rule mutation; route inspection shown",
          "invalid_input": "none",
          "decision_origin": "game_design"
        },
        {
          "id": "record_sound",
          "input": "hold 1.0s",
          "target": "active environmental sound source",
          "feedback": "source pulse + 1s fill + waveform token",
          "source_refs": [
            "core_player_verbs[1]",
            "game_rules.recording",
            "feedback_system.record"
          ],
          "precondition": "player within 1.5 tile path distance; token inventory <2; not caught; hold uninterrupted",
          "state_change": "on completion store one token with authored lure_strength; Planning→Infiltration if first committed action",
          "timing_rules": "1.0s uninterrupted",
          "invalid_input": "full inventory blocks; release/move/vision before completion cancels with no token",
          "spatial_rules": "path distance <=1.5 tiles",
          "cancel_behavior": "release, movement or entering guard vision cancels with no resource change",
          "decision_origin": "game_design"
        },
        {
          "id": "throw_sound",
          "input": "drag stored token and release",
          "target": "walkable floor tile",
          "feedback": "drag arc + valid tile + predicted propagation path/range; release creates sound ring and guard attention cues",
          "priority": "active token drag suppresses move taps",
          "source_refs": [
            "core_player_verbs[2]",
            "game_rules.throwing",
            "game_rules.sound",
            "game_rules.investigation",
            "interaction_spec.priority"
          ],
          "precondition": "token available; Manhattan distance <=6; unobstructed straight throw segment; not caught",
          "state_change": "valid release consumes token and creates 2s sound event; Planning→Infiltration if first committed action; hearing guards replan by strongest then newest tie-break",
          "timing_rules": "sound event lasts 2s; investigate lasts 2s on arrival",
          "invalid_input": "nonwalkable/out of range/through wall returns token unchanged and guard state unchanged",
          "spatial_rules": "Manhattan <=6; wall collision blocks straight throw; sound itself propagates shortest connected walkable path to lure_strength",
          "cancel_behavior": "release invalid or cancel outside world restores token slot",
          "decision_origin": "game_design"
        },
        {
          "id": "move_player",
          "input": "tap",
          "target": "reachable walkable floor tile",
          "feedback": "path preview then footsteps",
          "source_refs": [
            "core_player_verbs[3]",
            "game_rules.grid",
            "interaction_spec.priority"
          ],
          "precondition": "not Caught/Result; no Record/Steal hold; no token drag",
          "state_change": "player follows shortest orthogonal walkable path; first committed action enters Infiltration",
          "invalid_input": "unreachable/nonwalkable tile rejected with no movement",
          "spatial_rules": "orthogonal walkable graph; walls block movement",
          "decision_origin": "game_design"
        },
        {
          "id": "steal_target",
          "input": "hold 0.6s",
          "target": "mission target exhibit",
          "feedback": "0.6s pickup hold + pickup cue + exit highlight",
          "source_refs": [
            "core_player_verbs[4]",
            "game_rules.steal",
            "feedback_system.objective"
          ],
          "precondition": "adjacent; player currently unseen; not already carrying target",
          "state_change": "on completion target becomes carried; objective becomes exit",
          "timing_rules": "0.6s stationary hold",
          "invalid_input": "not adjacent blocks; visibility during hold cancels; continuous exposure can still cause Caught",
          "cancel_behavior": "movement/release/visibility cancels theft without completing",
          "decision_origin": "game_design"
        },
        {
          "id": "escape",
          "input": "enter tile via movement",
          "target": "authored exit",
          "feedback": "escape transition",
          "source_refs": [
            "core_player_verbs[5]",
            "game_rules.success"
          ],
          "precondition": "target carried",
          "state_change": "Mission→Success→Result",
          "invalid_input": "without target no transition; objective reminder",
          "decision_origin": "game_design"
