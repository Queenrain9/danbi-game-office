  "acceptance_criteria": [
    "All three screens and all Planning/Move/Wait/Shift/Pause/Result states are observable.",
    "Scout reveals Form A and alternate Form B and enforces two-per-turn.",
    "Record drag costs one Ink, locks current form and enforces one-per-turn.",
    "Move rejects diagonal, fog, Ridge and unaffordable targets without cost.",
    "World Shift toggles exactly revealed unrecorded unoccupied mutable tiles once.",
    "All four A/B pair classes are representable by the reusable TileCell variant.",
    "Spring first-entry recovery and consumed state are visible.",
    "Shrine entry at Stamina 1 succeeds at 0 while Wait at 1 fails.",
    "Retry fully restores mission state."
  ],
  "primary_interaction": "Scout + Record seal drag + adjacent Move/Wait",
  "interaction_principles": [
    "Map is the primary control surface",
    "Current and alternate tile forms remain simultaneously legible",
    "Record/Scout limits are visible before action",
