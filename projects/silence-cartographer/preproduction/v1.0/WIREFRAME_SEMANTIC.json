  "interaction_principles": [
    "The cave map is the primary play surface.",
    "Accepted turn actions resolve rule state immediately; presentation replays frozen events afterward.",
    "Only one continuous gameplay gesture may own the pointer at a time.",
    "While resolve presentation is playing, new gameplay actions are ignored; Pause may freeze/resume presentation after the committing pointer ends.",
    "Hidden predator response is directional only until its current tile is revealed.",
    "Invalid/cancelled input never spends Air/Clickers and never advances predator state."
  ],
  "global_ui_rules": {
    "reference_size": {
      "w": 540,
      "h": 960
    },
    "touch_target_min_px": 44,
    "safe_area": "interactive controls remain inside 4% horizontal and 3% vertical margins",
    "cave_grid": "M1-M3 use authored 4x4 tile coordinates inside the cave_map region; fixture topology is authoritative",
    "presentation": {
      "rule_commit": "immediate on accepted gesture completion",
      "echo_reveal_replay_max_ms": 320,
      "predator_replay_max_ms": 280,
      "gameplay_input_lock": "accepted rule action until presentation queue completes",
      "duplicate_input": "ignored while presentation lock is active",
      "pause_during_resolve": "freeze/resume presentation cursor without re-running the rule action"
    },
    "accessibility": [
      "shape/icon differences accompany color for tile/objective/predator states",
      "hidden predator cue uses direction icon plus pulse, not color only",
      "Air and Clickers always include numeric text"
    ]
  },
  "screen_flow": {
    "normal": [
      "S1_EXPEDITION_SELECT",
      "S2_MISSION_BRIEF",
      "S3_CAVE_EXPLORATION",
      "S5_MISSION_RESULT"
    ],
    "branches": [
      "S3_CAVE_EXPLORATION -> S4_PAUSE_OVERLAY -> S3_CAVE_EXPLORATION",
      "S5 success M1/M2 -> S2 next mission brief",
      "S5 retry -> S3 same mission reset",
      "S4 retry -> S3 same mission reset",
      "S4/S5 select -> S1"
    ],
    "guards": [
      "Only M1-M3 exist in First Build UI.",
      "Persistent grades/unlocks and M4-M6 are not shown.",
      "Terminal result blocks gameplay input immediately."
    ]
  },
