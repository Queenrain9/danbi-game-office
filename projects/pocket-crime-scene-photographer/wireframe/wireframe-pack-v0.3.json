      "interactions": [
        {
          "id": "P3_REPOSITION",
          "input": "single-finger horizontal drag",
          "target": "scene_drag_surface",
          "feedback": "scene parallax changes continuously",
          "source_refs": [
            "interaction_spec.reposition",
            "core_player_verbs[0]"
          ],
          "precondition": "Compose and no pinch/flash-angle drag active",
          "state_change": "camera_x changes within authored rail range and all projections update",
          "gesture_rules": {
            "priority": "ignored during pinch or flash-angle drag",
            "cancel_behavior": "release keeps current camera_x"
          },
          "invalid_input": "vertical-only drag below 0.05 normalized horizontal delta changes nothing",
          "spatial_rules": {
            "mapping": "camera_x += normalized_drag_dx*1.2 then clamp to case rail range"
          },
          "decision_origin": "game_design"
        },
        {
          "id": "P3_FRAME",
          "input": "two-finger pinch",
          "target": "scene_drag_surface / camera zoom",
          "feedback": "proof-set scale and frame boundaries update continuously",
          "source_refs": [
            "interaction_spec.frame",
            "core_player_verbs[1]"
          ],
          "precondition": "Compose",
          "state_change": "zoom changes continuously within 1.0..2.2 and projected radii/distances update",
          "gesture_rules": {
            "priority": "pinch overrides Reposition while two pointers are down",
            "cancel_behavior": "release keeps zoom"
          },
          "invalid_input": "no zoom change if gesture never becomes a valid pinch",
          "spatial_rules": {
            "mapping": "zoom *= pinch_scale then clamp 1.0..2.2"
          },
          "decision_origin": "game_design"
        },
        {
          "id": "P3_FOCUS",
          "input": "tap",
          "target": "in-frame unoccluded evidence on scene_drag_surface",
          "feedback": "focus marker moves; focus-required evidence sharpness updates; focus lock tick",
          "source_refs": [
            "interaction_spec.focus",
            "core_player_verbs[2]",
            "feedback_system.focus"
          ],
          "precondition": "Compose and release was not a drag >=0.05 normalized distance",
          "state_change": "focus_depth becomes tapped evidence depth",
          "gesture_rules": {
            "priority": "release after drag >=0.05 is not treated as focus tap"
          },
          "invalid_input": "background, occluder, out-of-frame or occluded evidence changes no focus value",
          "decision_origin": "game_design"
        },
        {
          "id": "P3_FLASH",
          "input": "flash toggle tap or horizontal angle drag",
          "target": "flash_toggle / flash_angle",
          "feedback": "flash-sensitive sheen updates continuously; light tick when entering accepted cone",
          "source_refs": [
            "interaction_spec.flash",
            "core_player_verbs[3]",
            "feedback_system.flash"
          ],
          "precondition": "Compose",
          "state_change": "flash_on toggles or flash_angle changes within -60..60 degrees",
          "gesture_rules": {
            "priority": "flash-angle control owns its pointer",
            "cancel_behavior": "release keeps angle"
          },
          "invalid_input": "angle drag outside its owned control does not change flash angle",
          "spatial_rules": {
            "mapping": "angle += normalized_horizontal_drag_dx*120 degrees then clamp -60..60"
          },
          "decision_origin": "game_design"
        },
        {
          "id": "P3_SHOOT",
          "input": "tap",
          "target": "shutter",
          "feedback": "brief capture freeze + shutter audio/haptic",
          "source_refs": [
            "interaction_spec.shoot",
            "core_player_verbs[4]",
            "game_rules.shot_resources"
          ],
          "precondition": "Compose, exposures>0, and no continuous gesture active",
          "state_change": "consume exactly one exposure, sample current composition, then camera_gameplay -> review_overlay",
          "gesture_rules": {
            "priority": "ignored while any continuous gesture pointer is active"
          },
          "invalid_input": "ignored during pinch/drag/Review/Pause or when exposures=0",
          "decision_origin": "game_design",
          "resource_effects": {
            "exposure_delta": -1
          }
        },
        {
          "id": "P3_PAUSE",
          "input": "tap",
          "target": "pause",
          "feedback": "camera input freezes and pause modal opens",
          "source_refs": [
