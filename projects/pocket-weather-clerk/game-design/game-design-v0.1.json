    "idea_id": "b05bf62b-6849-434c-82a4-6787557d18ef",
    "version": "v0.1",
    "one_line": "구름·바람·습도 장치를 직접 만져 미니어처 동네의 국지 날씨 주문을 맞추는 모바일 촉각 퍼즐.",
    "core_loop": "의뢰 확인 → 현재 상태 읽기 → 구름 드래그·바람 회전·습도 조절 → 1.2초 정착 관찰 → 미세 조정 → 제출 → 구역별 결과 확인 → 다음 의뢰. 플레이어는 숫자 정답을 고르는 대신 환경 반응을 읽어 직접 조작한다.",
    "mvp_scope": "6개 화면/overlay, 5개 데이터 주문, cloud drag/wind rotation/humidity drag, settle simulation, 결합 날씨 규칙, 평가·별, retry/next, Shift 완료 unlock을 구현한다.",
    "game_rules": {
      "rules": [
        "high humidity + low cloud + low wind = fog",
        "high humidity + sufficient cloud = rain",
        "strong wind moves/disperses clouds",
        "cloud footprint affects only overlapping districts"
      ],
      "score": "success 1 star; <=5 adjustments +1; no forbidden overshoot +1",
      "failure": "forbidden condition at submit or adjustment budget exceeded",
      "success": "all district targets within tolerance 15",
      "variables": {
        "humidity": "0-100",
        "cloud_cover": "0-100",
        "wind_strength": "0-3",
        "cloud_altitude": "low/mid/high",
        "wind_direction": "8-way"
      },
      "shift_orders": 5,
      "adjustment_budget": 8
