        },
        {
          "input": "tap",
          "action": "reset current order",
          "target": "restart",
          "feedback": "reset cue",
          "precondition": "paused",
          "state_change": "adjusting",
          "invalid_input": "none"
        },
        {
          "input": "tap",
          "action": "discard current order",
          "target": "exit",
          "feedback": "close",
          "precondition": "paused",
          "state_change": "board",
          "invalid_input": "none"
        }
      ],
      "state_variants": [],
      "implementation_notes": [
        "overlay scene; do not duplicate desk"
      ]
    },
