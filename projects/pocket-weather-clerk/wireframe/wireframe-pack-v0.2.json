    {
      "id": "weather_desk",
      "name": "Weather Desk",
      "order": 3,
      "layout": {
        "regions": [
          {
            "h": 12,
            "w": 92,
            "x": 4,
            "y": 4,
            "id": "hud",
            "role": "status",
            "label": "targets/status"
          },
          {
            "h": 25,
            "w": 90,
            "x": 5,
            "y": 18,
            "id": "sky",
            "role": "direct manipulation",
            "label": "cloud manipulation sky"
          },
          {
            "h": 29,
            "w": 90,
            "x": 5,
            "y": 44,
            "id": "town",
            "role": "world feedback",
            "label": "district diorama"
          },
          {
            "h": 20,
            "w": 90,
            "x": 5,
            "y": 75,
            "id": "controls",
            "role": "input",
            "label": "hardware controls"
          }
        ]
      },
      "states": [
        "adjusting",
        "dragging_cloud",
        "rotating_wind",
        "dragging_humidity",
        "settling",
        "evaluating",
        "locked_control"
      ],
      "purpose": "core tactile weather manipulation and evaluation entry",
      "feedback": [
        "world lighting/shadow/haze/rain are primary",
        "target satisfied preview glow does not award score"
      ],
      "components": [
        {
          "id": "target_strip",
          "box": {
            "h": 8,
            "w": 57,
            "x": 6,
            "y": 5
          },
          "type": "status",
          "label": "Target chips",
          "state_binding": "order.targets"
        },
        {
          "id": "adjust_count",
          "box": {
            "h": 8,
            "w": 14,
            "x": 66,
            "y": 5
          },
          "type": "counter",
          "label": "Adjustments",
          "state_binding": "adjustments/8"
        },
        {
          "id": "pause_btn",
          "box": {
            "h": 8,
            "w": 11,
            "x": 83,
            "y": 5
          },
          "type": "button",
          "label": "Pause",
          "enabled_when": "state in adjusting,settling",
          "state_binding": "not evaluating"
        },
        {
          "id": "cloud_bank",
          "box": {
            "h": 18,
            "w": 46,
            "x": 14,
            "y": 21
          },
          "type": "draggable",
          "label": "Cloud Bank",
          "enabled_when": "adjusting && !cloud_locked",
          "state_binding": "cloud.position,cover,altitude",
          "interaction_role": "drag start + live footprint"
        },
        {
          "id": "district_world",
          "box": {
            "h": 27,
            "w": 86,
            "x": 7,
            "y": 45
          },
          "type": "world_view",
          "label": "Town districts",
          "state_binding": "derived_weather,district current",
          "interaction_role": "gesture result feedback"
        },
        {
          "id": "wind_nozzle",
          "box": {
            "h": 16,
            "w": 23,
            "x": 7,
            "y": 77
          },
          "type": "rotary",
          "label": "Wind Nozzle",
          "enabled_when": "adjusting && !wind_locked",
          "state_binding": "wind_direction,wind_strength",
          "interaction_role": "circular drag"
        },
        {
          "id": "humidity_valve",
          "box": {
            "h": 16,
            "w": 18,
            "x": 34,
            "y": 77
          },
          "type": "vertical_slider",
          "label": "Humidity Valve",
          "enabled_when": "adjusting && !humidity_locked",
          "state_binding": "humidity",
          "interaction_role": "vertical drag"
        },
        {
          "id": "observe_btn",
          "box": {
            "h": 14,
            "w": 17,
            "x": 57,
            "y": 78
          },
          "type": "button",
          "label": "Observe",
          "enabled_when": "adjusting",
          "state_binding": "state",
          "interaction_role": "settle trigger"
        },
        {
          "id": "submit_btn",
          "box": {
            "h": 14,
            "w": 17,
            "x": 77,
            "y": 78
          },
          "type": "button",
          "label": "Submit",
          "enabled_when": "adjustments>0 && state=adjusting",
          "state_binding": "adjustments,state",
          "interaction_role": "evaluation trigger"
        },
        {
          "id": "settle_meter",
          "box": {
            "h": 3,
            "w": 37,
            "x": 57,
            "y": 73
          },
          "type": "progress",
          "label": "Settle progress",
          "enabled_when": "settling",
          "state_binding": "settle_time"
        }
      ],
      "edge_cases": [
        "multi-touch ignored after first pointer ownership",
        "budget 8 reached disables further device commits and enables submit",
        "locked device never increments adjustment"
      ],
      "transitions": [
        {
          "to": "order_result",
          "from": "weather_desk",
          "trigger": "evaluation complete",
          "animation": "result sheet up",
          "condition": "success or failure"
        },
        {
          "to": "pause_overlay",
          "from": "weather_desk",
          "trigger": "pause_btn",
          "animation": "overlay",
          "condition": "not evaluating"
        }
      ],
      "interactions": [
        {
          "input": "drag",
          "action": "move cloud within sky; derive footprint",
          "target": "cloud_bank",
          "feedback": "shadow/footprint + altitude haptic",
          "precondition": "adjusting && !cloud_locked",
          "state_change": "cloud position; on release adjustments+1 then settling",
          "invalid_input": "locked shake; out-of-sky clamps/last valid"
        },
        {
          "input": "circular_drag",
          "action": "snap 8-way direction and strength band",
          "target": "wind_nozzle",
          "feedback": "streamers/arrows + detent",
          "precondition": "adjusting && !wind_locked",
          "state_change": "wind; on release adjustments+1 then settling",
          "invalid_input": "cap haptic/no overflow"
        },
        {
          "input": "vertical_drag",
          "action": "snap 5 percent",
          "target": "humidity_valve",
          "feedback": "gauge/haze + 25% haptic",
          "precondition": "adjusting && !humidity_locked",
          "state_change": "humidity; on release adjustments+1 then settling",
          "invalid_input": "clamp/error pulse"
        },
        {
          "input": "tap",
          "action": "settle simulation",
          "target": "observe_btn",
          "feedback": "controls dim/world animates",
          "precondition": "adjusting",
          "state_change": "settling 1.2s then adjusting",
          "invalid_input": "ignored while settling"
        },
        {
          "input": "tap",
          "action": "evaluate districts",
          "target": "submit_btn",
          "feedback": "stamp + district compare",
          "precondition": "adjustments>0 && adjusting",
          "state_change": "evaluating then result",
          "invalid_input": "disabled pulse"
        }
      ],
      "state_variants": [
        {
          "id": "cloud_drag",
          "name": "Cloud Dragging",
          "notes": "town shadow updates live; adjustment commits on release once",
          "condition": "pointer owns cloud_bank",
          "components": [
            {
              "id": "cloud_hit_outline",
              "box": {
                "h": 25,
                "w": 55,
                "x": 10,
                "y": 18
              },
              "type": "overlay",
              "label": "Cloud hit/footprint",
              "state_binding": "drag candidate"
            }
          ],
          "hide_components": [],
          "component_overrides": {}
        },
        {
          "id": "settling_variant",
          "name": "Settling",
          "notes": "world becomes visual priority",
          "condition": "state=settling",
          "components": [],
          "hide_components": [],
          "component_overrides": {
            "cloud_bank": {
              "state_binding": "dim/input_locked"
            },
            "wind_nozzle": {
              "state_binding": "dim/input_locked"
            },
            "settle_meter": {
              "state_binding": "1.2s progress"
            },
            "humidity_valve": {
              "state_binding": "dim/input_locked"
            }
          }
        },
        {
          "id": "evaluating_variant",
          "name": "Evaluating",
          "notes": "all input locked",
          "condition": "state=evaluating",
          "components": [
            {
              "id": "district_compare",
              "box": {
                "h": 27,
                "w": 84,
                "x": 8,
                "y": 45
              },
              "type": "overlay",
              "label": "Target/current compare",
              "state_binding": "evaluation"
            }
          ],
          "hide_components": [],
          "component_overrides": {
            "submit_btn": {
              "state_binding": "disabled"
            }
          }
        }
      ],
      "implementation_notes": [
        "single WeatherSession owns variables",
        "debounce continuous drag into one commit",
        "derived weather recalculates after settle"
      ]
    },
