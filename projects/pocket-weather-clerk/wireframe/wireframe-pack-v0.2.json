          "label": "Order cards",
          "state_binding": "orders/unlocks",
          "interaction_role": "tap order"
        },
        {
          "id": "shift_progress",
          "box": {
            "h": 5,
            "w": 60,
            "x": 8,
            "y": 89
          },
          "type": "progress",
          "label": "Shift progress",
          "state_binding": "resolved_count"
        },
        {
          "id": "hard_lock",
          "box": {
            "h": 5,
            "w": 20,
            "x": 72,
            "y": 89
          },
          "type": "status",
          "label": "Hard Orders lock",
          "state_binding": "hard_unlocked"
        }
      ],
      "edge_cases": [
        "no unlocked order: first order forced unlocked"
      ],
      "transitions": [
        {
          "to": "order_brief",
          "from": "shift_board",
          "trigger": "unlocked order tap",
          "animation": "push",
          "condition": "order unlocked"
