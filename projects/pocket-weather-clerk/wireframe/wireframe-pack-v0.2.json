            "w": 88,
            "x": 6,
            "y": 18,
            "id": "orders",
            "role": "selection",
            "label": "order list"
          },
          {
            "h": 8,
            "w": 88,
            "x": 6,
            "y": 88,
            "id": "footer",
            "role": "status",
            "label": "progress"
          }
        ]
      },
      "states": [
        "ready",
        "locked"
      ],
      "purpose": "select current unlocked order and see shift progress",
      "feedback": [
        "progress updates after resolved order"
      ],
      "components": [
        {
          "id": "order_cards",
          "box": {
            "h": 62,
            "w": 84,
            "x": 8,
            "y": 20
          },
