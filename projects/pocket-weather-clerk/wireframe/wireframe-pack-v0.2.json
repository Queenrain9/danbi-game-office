          "precondition": "order unlocked",
          "state_change": "selected_order=id",
          "invalid_input": "locked card pulses"
        }
      ],
      "state_variants": [
        {
          "id": "hard_locked",
          "name": "Hard Locked",
          "notes": "tap locked card gives lock pulse",
          "condition": "shift not completed",
          "components": [],
          "hide_components": [],
          "component_overrides": {
            "hard_lock": {
              "label": "Locked"
            }
          }
        }
      ],
      "implementation_notes": [
        "data-driven cards from order dataset"
      ]
    },
