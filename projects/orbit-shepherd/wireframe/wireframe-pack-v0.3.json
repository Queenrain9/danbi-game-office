  "pack_markdown": "Orbit Shepherd Interaction Wireframe Pack v0.3. Fun promise: 탭 한 번으로 궤도가 크게 바뀌되 변화를 읽고 다음 토글로 수정하는 우주 목축. Flow: Stage Select → Observe(3s) → Playing → Success/Failure; Playing ↔ Pause. Core world is dominant, HUD peripheral. Planet taps are the only world-changing player input. Prediction and actual trail are distinct; target requires radius plus allowed speed. Retry restores full initial snapshot. Variation remains stage-data driven with no new mechanics.",
  "source_run_at": "2026-09-30T20:27:42.644008+00:00",
  "target_device": "mobile",
  "global_ui_rules": {
    "feedback": "planet body + influence field communicate gravity state",
    "source_refs": [
      "Visual Direction Brief",
      "Feedback System"
    ],
    "world_priority": "fixed 2D playfield dominates",
    "decision_origin": "wireframe_layout"
  },
  "developer_handoff": {
    "fun_promise": "탭 한 번으로 궤도가 크게 바뀌되, 플레이어가 그 변화를 읽고 다음 토글로 수정할 수 있는 우주 목축.",
    "source_refs": [
      "Wireframe Handoff",
      "Content Model"
    ],
    "data_boundary": "Stage data owns numeric/spatial rules; wireframe boxes are presentation only.",
    "decision_note": "UX completion only; no game-rule change.",
    "decision_origin": "wireframe_completion",
    "upstream_issues": [],
    "content_variation": "Same gameplay template represents planet count/layout/strength, flock starts, target constraints, time and bounds.",
    "architecture_boundary": "Implementation Blueprint chooses Godot architecture."
  },
  "acceptance_criteria": [
    "Stage Select maps locked/unlocked progression",
    "Gameplay covers 3-second OBSERVE and PLAYING",
    "Valid planet tap changes gravity and immediately refreshes prediction",
    "HUD exposes arrived/K, time and arrival-speed condition",
    "Prediction, actual trail, gravity state and creature states remain distinguishable",
    "Pause freezes simulation and resume preserves exact state",
    "Retry restores complete initial snapshot and OBSERVE",
    "Success triggers at arrived_count>=K",
    "Failure triggers at timer<=0 or lost_count>N-K",
    "No direct creature control, planet movement, economy, upgrades or stars"
  ],
  "primary_interaction": "행성을 탭해 중력을 실시간 ON/OFF하며 생물 무리의 궤도를 수정",
  "interaction_principles": [
    "Tap planets; never directly manipulate creatures",
    "Keep prediction and actual trails distinct",
    "Observe is read-only; Playing applies valid taps on next physics tick"
  ]
