      "interactions": [
        {
          "id": "K2_INSPECT_LENS",
          "input": "drag",
          "target": "lens over lock_cutaway",
          "feedback": "pin highlight + metal tick/haptic",
          "source_refs": [
            "core_player_verbs[0]",
            "feedback_system.inspect"
          ],
          "precondition": "state=Inspect",
          "state_change": "reveals target pin heights/order under the lens; craft depth unchanged",
          "gesture_rules": {
            "single_pointer": true
          },
          "invalid_input": "drag outside lock cutaway reveals nothing and changes no craft state",
          "decision_origin": "game_design"
        },
        {
          "id": "K2_MOUNT_BLANK",
          "input": "tap",
          "target": "start_cut",
          "feedback": "blank snaps into work position",
          "source_refs": [
            "state_model[0]",
            "game_rules.blank_count"
          ],
          "precondition": "state=Inspect and at least one usable blank selected",
          "state_change": "Inspect -> Cut; mounts the selected fresh blank",
          "decision_note": "Closes the authored Inspect exit with an explicit local control.",
          "invalid_input": "disabled when no usable blank exists",
          "decision_origin": "wireframe_completion"
        },
        {
          "id": "K2_COARSE_FILE",
          "input": "drag stroke",
          "target": "one valid key tooth",
          "feedback": "visible shavings/profile change + scrape audio + texture haptic; warning edge when crossing target tolerance toward overcut",
          "source_refs": [
            "interaction_spec.cut",
            "game_rules.cut_rule",
            "feedback_system.cut",
            "feedback_system.overcut"
          ],
          "precondition": "state=Cut and coarse_file selected",
          "state_change": "irreversibly lowers the contacted tooth according to the authored coarse-file rule; depth remains clamped 0..1",
          "gesture_rules": {
            "priority": "active craft stroke over background pan",
            "cancel_behavior": "lifting ends the current stroke"
          },
          "invalid_input": "stroke begun outside a tooth or outside the 44pt tooth target causes no cut",
          "spatial_rules": {
            "target": "44pt minimum tooth target"
          },
          "decision_origin": "game_design"
        },
        {
          "id": "K2_FINE_FILE",
          "input": "short drag strokes",
          "target": "one valid key tooth",
          "feedback": "fine scrape + small shaving/profile increment",
          "source_refs": [
            "interaction_spec.fine",
            "core_player_verbs[2]"
          ],
          "precondition": "state=Cut and fine_file selected",
          "state_change": "each valid fine step irreversibly lowers depth by 0.01, clamped to 0..1",
          "gesture_rules": {
            "cancel_behavior": "lifting ends the active stroke"
          },
          "invalid_input": "outside-tooth stroke makes no state change",
          "decision_origin": "game_design",
          "resource_effects": {
            "depth_delta": -0.01
          }
        },
        {
          "id": "K2_INSERT_TEST",
          "input": "drag",
          "target": "insert_key into lock_cutaway",
          "feedback": "key snaps into lock; pin contacts become visible",
          "source_refs": [
            "interaction_spec.test.insert",
            "state_model[1]"
          ],
          "precondition": "state=Cut and a blank is mounted",
          "state_change": "Cut -> Test when insertion reaches snap target",
          "invalid_input": "release before snap returns key to work position and consumes no test",
          "decision_origin": "game_design"
        },
        {
          "id": "K2_ROTATE_TEST",
          "input": "clockwise arc drag",
          "target": "rotation_arc",
          "feedback": "pin contact + torque resistance + click/haptic; clean full-turn clack on success",
          "source_refs": [
            "game_rules.success",
            "game_rules.tolerance",
            "game_rules.test_limit",
            "interaction_spec.test",
            "feedback_system.test",
            "feedback_system.success"
          ],
          "precondition": "state=Test and inserted key is snapped",
          "state_change": "consumes one test; if every pin error <=0.08 and rotation reaches 75° -> K3 success; otherwise rotation stops proportional to worst error and state -> Diagnostic; terminal failure if test limit or timer/blank rule is exhausted",
          "invalid_input": "reverse/outside arc does not advance rotation or consume an additional test",
          "spatial_rules": {
            "success_rotation_deg": 75
          },
          "decision_origin": "game_design",
          "resource_effects": {
            "test_count_delta": 1
          }
        },
        {
          "id": "K2_RETURN_REWORK",
          "input": "tap",
          "target": "return_cut",
          "feedback": "diagnostic panel retracts; key returns to work position",
          "source_refs": [
            "state_model[3]",
            "game_rules.overcut"
          ],
          "precondition": "state=Diagnostic and current blank remains usable",
          "state_change": "Diagnostic -> Cut; preserves all irreversible cut depth",
          "decision_note": "Implements the authored Diagnostic→Cut recovery without modifying craft state.",
          "invalid_input": "disabled if terminal failure condition already applies",
          "decision_origin": "wireframe_completion"
        },
        {
          "id": "K2_REPLACE_BLANK",
          "input": "hold-confirm",
          "target": "replace_blank / replace_confirm",
          "feedback": "explicit hold progress followed by fresh blank swap",
          "source_refs": [
            "interaction_spec.replacement",
            "game_rules.blank_count",
            "game_rules.scoring.replacement_penalty"
          ],
          "precondition": "state=Diagnostic and one spare blank remains",
          "state_change": "Diagnostic -> Replace Confirm -> Cut; consumes one spare blank and resets tooth depths to a fresh blank",
          "invalid_input": "release before confirm cancels with no resource change; unavailable with no spare blank",
          "decision_origin": "game_design",
          "resource_effects": {
            "blank_delta": -1,
            "score_penalty": 200
          }
        },
        {
          "id": "K2_PAUSE",
          "input": "tap",
          "target": "pause",
          "feedback": "craft/timer freeze and pause overlay opens",
          "source_refs": [
            "screen_inventory[3]"
          ],
          "precondition": "any nonterminal K2 state",
          "state_change": "K2 -> K4 while preserving exact K2 state",
          "decision_note": "Pause presentation preserves authored state.",
          "invalid_input": "ignored during terminal transition to K3",
          "decision_origin": "wireframe_completion"
        }
      ],
