    ]
  },
  "acceptance_criteria": [
    "All five Game Design screens are reachable and represented.",
    "Each of the five regions exposes heat/form/locked state and a manipulation hit area.",
    "Heat at 50 enables shaping; 80 warns; 90 sustained for 1 second applies the specified overheat penalty.",
    "Cooling below 25 locks and reheating to 50 unlocks.",
